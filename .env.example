# Copy to .env and adjust. docker-compose reads these automatically.

# Port the web UI is exposed on (bound to 127.0.0.1 only).
APP_PORT=3000

# Transmission RPC endpoint as seen from the container.
# On macOS + Docker Desktop, host.docker.internal is your Mac.
TRANSMISSION_RPC_URL=http://host.docker.internal:9091/transmission/rpc

# Only if you enabled RPC authentication in Transmission:
#TRANSMISSION_RPC_USERNAME=
#TRANSMISSION_RPC_PASSWORD=

# Your Transmission download directory on the Mac (the SSD primary location).
# It is mounted read-write into the container at /data so the app can delete
# unselected junk files. Example:
#HOST_DOWNLOAD_DIR=/Users/ralim1/Downloads

# Path of your external HDD as Transmission sees it — preset for the Move dialog.
# Example:
#MOVE_DESTINATION=/Volumes/MyHDD/Downloads
